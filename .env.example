# Copy to .env (never commit .env) or export these variables in the web server.
# The application connects directly to PostgreSQL as a restricted SQL role.
# Never use postgres, supabase_admin, a service_role key, or a browser key here.

APP_ENV=production

# Supabase: Dashboard -> Connect -> Session pooler.
# Use the session pooler (port 5432): it supports native prepared statements.
# Do NOT use the transaction pooler (port 6543) for this application.
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# The pooler username is <runtime-role>.<project-ref>, for example:
DB_USER=bookshop_app.abcdefghijklmnop
DB_PASSWORD=replace-with-a-long-random-runtime-password
# Remote hosts must use verify-full with a trusted CA certificate file.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/absolute/path/to/supabase-ca.crt

# Local development only: APP_ENV=local with DB_SSLMODE=disable and an empty
# DB_PASSWORD is accepted for 127.0.0.1/::1 trust-authenticated test clusters.

# Operator-only, used by scripts/bootstrap-admin.php (CLI, never web).
ADMIN_DB_HOST=aws-0-region.pooler.supabase.com
ADMIN_DB_PORT=5432
ADMIN_DB_NAME=postgres
ADMIN_DB_USER=postgres.abcdefghijklmnop
ADMIN_DB_PASSWORD=replace-with-the-migration-owner-password
ADMIN_DB_SSLMODE=verify-full
ADMIN_DB_SSLROOTCERT=/absolute/path/to/supabase-ca.crt

# First administrator. Keep out of shell history and CI logs.
BOOKSHOP_ADMIN_USERNAME=admin
BOOKSHOP_ADMIN_EMAIL=admin@example.com
BOOKSHOP_ADMIN_PASSWORD=replace-with-a-unique-12-to-72-byte-password
