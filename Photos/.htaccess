# Uploaded book covers are data, never executable code.
<FilesMatch "\.(?i:php|phtml|phar|pht|phps|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
